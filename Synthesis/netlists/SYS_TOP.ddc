module RX_FSM ( RX_IN, PAR_EN, PRESCALE, EDGE_CNT, BIT_CNT, PAR_ERR, 
        STRT_GLITCH, STP_ERR, CLK, RST, DATA_SAMP_EN, CNT_EN, PAR_CHK_EN, 
        STRT_CHK_EN, STOP_CHK_EN, DESER_EN, DATA_VALID, DESER_STORE );
  input [5:0] PRESCALE;
  input [4:0] EDGE_CNT;
  input [3:0] BIT_CNT;
  input RX_IN, PAR_EN, PAR_ERR, STRT_GLITCH, STP_ERR, CLK, RST;
  output DATA_SAMP_EN, CNT_EN, PAR_CHK_EN, STRT_CHK_EN, STOP_CHK_EN, DESER_EN,
         DATA_VALID, DESER_STORE;
  wire   N11, N12, N13, N14, N15, N16, edge_done, N17, N18, N19, N20, N21,
         sample_tick, n22, n23, n24, n25, n26, n27, n28, n29, n30, n31, n32,
         n33, n34, n35, n36, \r77/carry[2] , \r77/carry[3] , \r77/carry[4] ,
         n2, n3, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n16,
         n17, n18, n19, n20, n21, n37, n38, n39, n40, n41, n42, n43, n44, n45,
         n46, n47, n48, n49, n50, n51, n52;
  wire   [2:0] NS;
  wire   [2:0] CS;

  DFFRQX2M DESER_STORE_reg ( .D(n36), .CK(CLK), .RN(RST), .Q(DESER_STORE) );
  DFFRQX2M \CS_reg[1]  ( .D(NS[1]), .CK(CLK), .RN(RST), .Q(CS[1]) );
  DFFRQX2M \CS_reg[2]  ( .D(NS[2]), .CK(CLK), .RN(RST), .Q(CS[2]) );
