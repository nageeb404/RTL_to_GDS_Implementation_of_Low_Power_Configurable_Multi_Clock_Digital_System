module UART_RX_TOP ( RX_IN, PAR_EN, PAR_TYP, PRESCALE, CLK, RST, P_DATA, 
        PAR_ERR, STP_ERR, DATA_VALID );
  input [5:0] PRESCALE;
  output [7:0] P_DATA;
  input RX_IN, PAR_EN, PAR_TYP, CLK, RST;
  output PAR_ERR, STP_ERR, DATA_VALID;
  wire   DATA_SAMP_EN_WIRE, SAMPLED_BIT_WIRE, CNT_EN_WIRE, PAR_CHK_EN_WIRE,
         STRT_CHK_EN_WIRE, STRT_GLITCH_WIRE, STOP_CHK_EN_WIRE, DESER_EN_WIRE,
         DESER_STORE_WIRE, n1, n2;
  wire   [4:0] EDGE_CNT_WIRE;
  wire   [3:0] BIT_CNT_WIRE;
  wire   [7:0] P_DATA_PAR_WIRE;

  data_sampler DUT0 ( .RX_IN(RX_IN), .DATA_SAMP_EN(DATA_SAMP_EN_WIRE), 
        .PRESCALE(PRESCALE), .EDGE_CNT(EDGE_CNT_WIRE), .CLK(CLK), .RST(n1), 
        .SAMPLED_BIT(SAMPLED_BIT_WIRE) );
  edge_bit_counter DUT1 ( .CNT_EN(CNT_EN_WIRE), .PRESCALE(PRESCALE), .PAR_EN(
        PAR_EN), .CLK(CLK), .RST(n1), .EDGE_CNT(EDGE_CNT_WIRE), .BIT_CNT(
        BIT_CNT_WIRE) );
  parity_check DUT2 ( .PAR_TYP(PAR_TYP), .PAR_CHK_EN(PAR_CHK_EN_WIRE), 
        .SAMPLED_BIT(SAMPLED_BIT_WIRE), .P_DATA(P_DATA_PAR_WIRE), .PAR_ERR(
        PAR_ERR) );
  start_check DUT3 ( .STRT_CHK_EN(STRT_CHK_EN_WIRE), .SAMPLED_BIT(
        SAMPLED_BIT_WIRE), .STRT_GLITCH(STRT_GLITCH_WIRE) );
  stop_check DUT4 ( .STOP_CHK_EN(STOP_CHK_EN_WIRE), .SAMPLED_BIT(
        SAMPLED_BIT_WIRE), .STP_ERR(STP_ERR) );
  deserializer DUT5 ( .DESER_EN(DESER_EN_WIRE), .SAMPLED_BIT(SAMPLED_BIT_WIRE), 
        .CLK(CLK), .RST(n1), .DATA_VALID(DESER_STORE_WIRE), .P_DATA(P_DATA), 
        .P_DATA_PAR(P_DATA_PAR_WIRE) );
  RX_FSM DUT6 ( .RX_IN(RX_IN), .PAR_EN(PAR_EN), .PRESCALE(PRESCALE), 
        .EDGE_CNT(EDGE_CNT_WIRE), .BIT_CNT(BIT_CNT_WIRE), .PAR_ERR(PAR_ERR), 
        .STRT_GLITCH(STRT_GLITCH_WIRE), .STP_ERR(STP_ERR), .CLK(CLK), .RST(n1), 
        .DATA_SAMP_EN(DATA_SAMP_EN_WIRE), .CNT_EN(CNT_EN_WIRE), .PAR_CHK_EN(
        PAR_CHK_EN_WIRE), .STRT_CHK_EN(STRT_CHK_EN_WIRE), .STOP_CHK_EN(
        STOP_CHK_EN_WIRE), .DESER_EN(DESER_EN_WIRE), .DATA_VALID(DATA_VALID), 
        .DESER_STORE(DESER_STORE_WIRE) );
  INVX4M U1 ( .A(n2), .Y(n1) );
  INVX2M U2 ( .A(RST), .Y(n2) );
endmodule


module UART ( RST, TX_CLK, RX_CLK, parity_type, parity_enable, RX_IN, 
        RX_PRESCALE, RX_P_DATA, RX_DATA_VALID, RX_PAR_ERR, RX_STP_ERR, 
        TX_P_DATA, TX_DATA_VALID, TX_OUT, TX_BUSY );
  input [5:0] RX_PRESCALE;
  output [7:0] RX_P_DATA;
  input [7:0] TX_P_DATA;
  input RST, TX_CLK, RX_CLK, parity_type, parity_enable, RX_IN, TX_DATA_VALID;
  output RX_DATA_VALID, RX_PAR_ERR, RX_STP_ERR, TX_OUT, TX_BUSY;
  wire   n1, n2;

  UART_TX_TOP U_TX ( .P_DATA(TX_P_DATA), .DATA_VALID(TX_DATA_VALID), .PAR_EN(
        parity_enable), .PAR_TYP(parity_type), .CLK(TX_CLK), .RST(n1), 
        .TX_OUT(TX_OUT), .BUSY(TX_BUSY) );
  UART_RX_TOP U_RX ( .RX_IN(RX_IN), .PAR_EN(parity_enable), .PAR_TYP(
        parity_type), .PRESCALE(RX_PRESCALE), .CLK(RX_CLK), .RST(n1), .P_DATA(
        RX_P_DATA), .PAR_ERR(RX_PAR_ERR), .STP_ERR(RX_STP_ERR), .DATA_VALID(
        RX_DATA_VALID) );
  INVX2M U1 ( .A(n2), .Y(n1) );
  INVX2M U2 ( .A(RST), .Y(n2) );
endmodule


