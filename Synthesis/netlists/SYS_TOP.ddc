module serializer_WIDTH8 ( CLK, RST, P_DATA, ser_en, BUSY, DATA_VALID, 
        ser_data, ser_done );
  input [7:0] P_DATA;
  input CLK, RST, ser_en, BUSY, DATA_VALID;
  output ser_data, ser_done;
  wire   N23, N24, N25, n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15,
         n16, n17, n18, n19, n20, n21, n22, n23, n1, n2, n3, n24;
  wire   [7:1] data_reg;
  wire   [2:0] COUNTER;

  DFFRQX2M \data_reg_reg[6]  ( .D(n18), .CK(CLK), .RN(RST), .Q(data_reg[6]) );
  DFFRQX2M \data_reg_reg[5]  ( .D(n19), .CK(CLK), .RN(RST), .Q(data_reg[5]) );
  DFFRQX2M \data_reg_reg[4]  ( .D(n20), .CK(CLK), .RN(RST), .Q(data_reg[4]) );
  DFFRQX2M \data_reg_reg[3]  ( .D(n21), .CK(CLK), .RN(RST), .Q(data_reg[3]) );
  DFFRQX2M \data_reg_reg[2]  ( .D(n22), .CK(CLK), .RN(RST), .Q(data_reg[2]) );
  DFFRQX2M \data_reg_reg[1]  ( .D(n23), .CK(CLK), .RN(RST), .Q(data_reg[1]) );
  DFFRQX2M \data_reg_reg[0]  ( .D(n16), .CK(CLK), .RN(RST), .Q(ser_data) );
  DFFRQX2M \data_reg_reg[7]  ( .D(n17), .CK(CLK), .RN(RST), .Q(data_reg[7]) );
  DFFRQX2M \COUNTER_reg[1]  ( .D(N24), .CK(CLK), .RN(RST), .Q(COUNTER[1]) );
  DFFRQX2M \COUNTER_reg[2]  ( .D(N25), .CK(CLK), .RN(RST), .Q(COUNTER[2]) );
  DFFRQX2M \COUNTER_reg[0]  ( .D(N23), .CK(CLK), .RN(RST), .Q(COUNTER[0]) );
  NOR2X2M U3 ( .A(n2), .B(n1), .Y(n6) );
  NOR2X2M U4 ( .A(n1), .B(n6), .Y(n4) );
  INVX2M U5 ( .A(ser_en), .Y(n2) );
  BUFX2M U6 ( .A(n7), .Y(n1) );
  NOR2BX2M U7 ( .AN(DATA_VALID), .B(BUSY), .Y(n7) );
  OAI2BB1X2M U8 ( .A0N(n4), .A1N(data_reg[6]), .B0(n8), .Y(n18) );
  AOI22X1M U9 ( .A0(data_reg[7]), .A1(n6), .B0(P_DATA[6]), .B1(n1), .Y(n8) );
  OAI2BB1X2M U10 ( .A0N(n4), .A1N(data_reg[2]), .B0(n12), .Y(n22) );
  AOI22X1M U11 ( .A0(data_reg[3]), .A1(n6), .B0(P_DATA[2]), .B1(n1), .Y(n12)
         );
  OAI2BB1X2M U12 ( .A0N(n4), .A1N(data_reg[3]), .B0(n11), .Y(n21) );
  AOI22X1M U13 ( .A0(data_reg[4]), .A1(n6), .B0(P_DATA[3]), .B1(n1), .Y(n11)
         );
  OAI2BB1X2M U14 ( .A0N(ser_data), .A1N(n4), .B0(n5), .Y(n16) );
  AOI22X1M U15 ( .A0(data_reg[1]), .A1(n6), .B0(P_DATA[0]), .B1(n1), .Y(n5) );
  OAI2BB1X2M U16 ( .A0N(n4), .A1N(data_reg[4]), .B0(n10), .Y(n20) );
  AOI22X1M U17 ( .A0(data_reg[5]), .A1(n6), .B0(P_DATA[4]), .B1(n1), .Y(n10)
         );
  OAI2BB1X2M U18 ( .A0N(data_reg[1]), .A1N(n4), .B0(n13), .Y(n23) );
  AOI22X1M U19 ( .A0(data_reg[2]), .A1(n6), .B0(P_DATA[1]), .B1(n1), .Y(n13)
         );
  OAI2BB1X2M U20 ( .A0N(n4), .A1N(data_reg[5]), .B0(n9), .Y(n19) );
  AOI22X1M U21 ( .A0(data_reg[6]), .A1(n6), .B0(P_DATA[5]), .B1(n1), .Y(n9) );
  AO22X1M U22 ( .A0(n4), .A1(data_reg[7]), .B0(P_DATA[7]), .B1(n1), .Y(n17) );
  OAI2BB2X1M U23 ( .B0(n14), .B1(n2), .A0N(COUNTER[2]), .A1N(N23), .Y(N25) );
  AOI32X1M U24 ( .A0(COUNTER[0]), .A1(n24), .A2(COUNTER[1]), .B0(COUNTER[2]), 
        .B1(n3), .Y(n14) );
  INVX2M U25 ( .A(COUNTER[2]), .Y(n24) );
  AND3X2M U26 ( .A(COUNTER[0]), .B(COUNTER[2]), .C(COUNTER[1]), .Y(ser_done)
         );
  NOR2X2M U27 ( .A(n2), .B(COUNTER[0]), .Y(N23) );
  NOR2X2M U28 ( .A(n15), .B(n2), .Y(N24) );
  CLKXOR2X2M U29 ( .A(COUNTER[0]), .B(n3), .Y(n15) );
  INVX2M U30 ( .A(COUNTER[1]), .Y(n3) );
endmodule


module parity_calc ( P_DATA, DATA_VALID, BUSY, PAR_TYP, CLK, RST, PAR_BIT );
  input [7:0] P_DATA;
  input DATA_VALID, BUSY, PAR_TYP, CLK, RST;
  output PAR_BIT;
  wire   n1, n2, n3, n4, n5, n6, n7;

  DFFRQX2M PAR_BIT_reg ( .D(n7), .CK(CLK), .RN(RST), .Q(PAR_BIT) );
  XNOR2X2M U2 ( .A(P_DATA[3]), .B(P_DATA[2]), .Y(n5) );
  XOR3XLM U3 ( .A(P_DATA[5]), .B(P_DATA[4]), .C(n6), .Y(n3) );
  CLKXOR2X2M U4 ( .A(P_DATA[7]), .B(P_DATA[6]), .Y(n6) );
  OAI2BB2X1M U5 ( .B0(n1), .B1(n2), .A0N(PAR_BIT), .A1N(n2), .Y(n7) );
  NAND2BX2M U6 ( .AN(BUSY), .B(DATA_VALID), .Y(n2) );
  XOR3XLM U7 ( .A(n3), .B(PAR_TYP), .C(n4), .Y(n1) );
  XOR3XLM U8 ( .A(P_DATA[1]), .B(P_DATA[0]), .C(n5), .Y(n4) );
endmodule


module TX_FSM ( DATA_VALID, PAR_EN, SER_DONE, CLK, RST, MUX_SEL, SER_EN, BUSY
 );
  output [1:0] MUX_SEL;
  input DATA_VALID, PAR_EN, SER_DONE, CLK, RST;
  output SER_EN, BUSY;
  wire   N45, n2, n3, n4, n1, n5;
  wire   [4:0] CS;
  wire   [2:0] NS;

  DFFRQX2M \CS_reg[2]  ( .D(NS[2]), .CK(CLK), .RN(RST), .Q(CS[2]) );
  DFFRQX2M BUSY_reg ( .D(N45), .CK(CLK), .RN(RST), .Q(BUSY) );
  DFFRQX2M \CS_reg[0]  ( .D(NS[0]), .CK(CLK), .RN(RST), .Q(CS[0]) );
  DFFRQX2M \CS_reg[1]  ( .D(NS[1]), .CK(CLK), .RN(RST), .Q(CS[1]) );
  NOR2X2M U3 ( .A(n2), .B(n1), .Y(SER_EN) );
  NAND2X2M U4 ( .A(n2), .B(MUX_SEL[0]), .Y(NS[1]) );
  OAI22X1M U5 ( .A0(SER_DONE), .A1(MUX_SEL[0]), .B0(CS[1]), .B1(n4), .Y(NS[0])
         );
  AOI21BX2M U6 ( .A0(DATA_VALID), .A1(n5), .B0N(MUX_SEL[0]), .Y(n4) );
  NAND2X2M U7 ( .A(CS[1]), .B(n5), .Y(n2) );
  INVX2M U8 ( .A(n2), .Y(MUX_SEL[1]) );
  NAND2X2M U9 ( .A(CS[0]), .B(n5), .Y(MUX_SEL[0]) );
  NOR2X2M U10 ( .A(n3), .B(n2), .Y(NS[2]) );
  AOI2B1X1M U11 ( .A1N(PAR_EN), .A0(SER_DONE), .B0(n1), .Y(n3) );
  INVX2M U12 ( .A(CS[2]), .Y(n5) );
  NAND3BX2M U13 ( .AN(CS[1]), .B(n1), .C(n5), .Y(N45) );
  INVX2M U14 ( .A(CS[0]), .Y(n1) );
endmodule


module MUX4x1 ( i00, i01, i10, i11, MUX_SEL, CLK, RST, TX_OUT );
  input [1:0] MUX_SEL;
  input i00, i01, i10, i11, CLK, RST;
  output TX_OUT;
  wire   N13, n2, n3, n1;

  DFFSQX2M TX_OUT_reg ( .D(N13), .CK(CLK), .SN(RST), .Q(TX_OUT) );
  INVX2M U3 ( .A(MUX_SEL[0]), .Y(n1) );
  OAI2B2X1M U4 ( .A1N(MUX_SEL[1]), .A0(n2), .B0(MUX_SEL[1]), .B1(n3), .Y(N13)
         );
  AOI22X1M U5 ( .A0(i00), .A1(n1), .B0(i01), .B1(MUX_SEL[0]), .Y(n3) );
  AOI22X1M U6 ( .A0(i10), .A1(n1), .B0(i11), .B1(MUX_SEL[0]), .Y(n2) );
endmodule


module UART_TX_TOP ( P_DATA, DATA_VALID, PAR_EN, PAR_TYP, CLK, RST, TX_OUT, 
        BUSY );
  input [7:0] P_DATA;
  input DATA_VALID, PAR_EN, PAR_TYP, CLK, RST;
  output TX_OUT, BUSY;
  wire   ser_en_w, ser_data_w, ser_done_w, par_bit_w;
  wire   [1:0] mux_sel_w;

  serializer_WIDTH8 ser ( .CLK(CLK), .RST(RST), .P_DATA(P_DATA), .ser_en(
        ser_en_w), .BUSY(BUSY), .DATA_VALID(DATA_VALID), .ser_data(ser_data_w), 
        .ser_done(ser_done_w) );
  parity_calc par ( .P_DATA(P_DATA), .DATA_VALID(DATA_VALID), .BUSY(BUSY), 
        .PAR_TYP(PAR_TYP), .CLK(CLK), .RST(RST), .PAR_BIT(par_bit_w) );
  TX_FSM fsm ( .DATA_VALID(DATA_VALID), .PAR_EN(PAR_EN), .SER_DONE(ser_done_w), 
        .CLK(CLK), .RST(RST), .MUX_SEL(mux_sel_w), .SER_EN(ser_en_w), .BUSY(
        BUSY) );
  MUX4x1 mux ( .i00(1'b0), .i01(1'b1), .i10(ser_data_w), .i11(par_bit_w), 
        .MUX_SEL(mux_sel_w), .CLK(CLK), .RST(RST), .TX_OUT(TX_OUT) );
endmodule


module data_sampler ( RX_IN, DATA_SAMP_EN, PRESCALE, EDGE_CNT, CLK, RST, 
        SAMPLED_BIT );
  input [5:0] PRESCALE;
  input [4:0] EDGE_CNT;
  input RX_IN, DATA_SAMP_EN, CLK, RST;
  output SAMPLED_BIT;
  wire   N6, N7, N8, N9, N10, N11, N12, N13, N15, N16, N17, N18, N19, N20, N21,
         N22, N23, N24, N25, N26, N27, n16, n17, n18, n19, n20, n21, n22, n23,
         n24, n25, n26, \add_26_2/carry[4] , \add_26_2/carry[3] ,
         \add_26/carry[4] , \add_26/carry[3] , \add_26/carry[2] , n1, n2, n3,
         n4, n5, n6, n7, n8, n9, n10, n11, n12, n13, n14, n15, n27, n28, n29,
         n30, n31, n32, n33, n34, n35, n36, n37, n38, n39, n40, n41, n42, n43,
         n44, n45, n46, n47;
  wire   [2:0] SAMPLES;
  assign N21 = PRESCALE[1];

  DFFRQX2M \SAMPLES_reg[2]  ( .D(n26), .CK(CLK), .RN(RST), .Q(SAMPLES[2]) );
  DFFRQX2M \SAMPLES_reg[0]  ( .D(n24), .CK(CLK), .RN(RST), .Q(SAMPLES[0]) );
  DFFRQX2M \SAMPLES_reg[1]  ( .D(n25), .CK(CLK), .RN(RST), .Q(SAMPLES[1]) );
  DFFRQX2M SAMPLED_BIT_reg ( .D(n23), .CK(CLK), .RN(RST), .Q(SAMPLED_BIT) );
  NOR3BX2M U3 ( .AN(DATA_SAMP_EN), .B(N12), .C(N13), .Y(n18) );
  OAI2BB2X1M U4 ( .B0(n47), .B1(n22), .A0N(n22), .A1N(SAMPLES[2]), .Y(n26) );
  NAND2X2M U5 ( .A(N20), .B(n18), .Y(n22) );
  OAI2BB2X1M U6 ( .B0(n16), .B1(n17), .A0N(SAMPLED_BIT), .A1N(n17), .Y(n23) );
  AOI21X2M U7 ( .A0(SAMPLES[1]), .A1(SAMPLES[0]), .B0(n19), .Y(n16) );
  NAND3BX2M U8 ( .AN(N20), .B(n18), .C(N27), .Y(n17) );
  OA21X2M U9 ( .A0(SAMPLES[1]), .A1(SAMPLES[0]), .B0(SAMPLES[2]), .Y(n19) );
  OAI2BB2X1M U10 ( .B0(n20), .B1(n47), .A0N(n20), .A1N(SAMPLES[0]), .Y(n24) );
  NAND2X2M U11 ( .A(N12), .B(DATA_SAMP_EN), .Y(n20) );
  OAI2BB2X1M U12 ( .B0(n47), .B1(n21), .A0N(n21), .A1N(SAMPLES[1]), .Y(n25) );
  NAND3BX2M U13 ( .AN(N12), .B(DATA_SAMP_EN), .C(N13), .Y(n21) );
  INVX2M U14 ( .A(RX_IN), .Y(n47) );
  OR2X2M U15 ( .A(PRESCALE[2]), .B(N21), .Y(n1) );
  INVX2M U16 ( .A(PRESCALE[2]), .Y(N22) );
  ADDHX1M U17 ( .A(PRESCALE[3]), .B(\add_26/carry[2] ), .CO(\add_26/carry[3] ), 
        .S(N16) );
  ADDHX1M U18 ( .A(PRESCALE[4]), .B(\add_26/carry[3] ), .CO(\add_26/carry[4] ), 
        .S(N17) );
