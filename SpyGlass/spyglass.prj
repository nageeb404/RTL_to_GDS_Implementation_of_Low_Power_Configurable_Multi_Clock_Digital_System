read_file -type verilog ../rtl/ASYNC_FIFO/fifo_wr.v
read_file -type verilog ../rtl/CLKDIV_MUX/CLKDIV_MUX.v
read_file -type verilog ../rtl/Top/SYS_TOP.v
read_file -type verilog ../rtl/Clock_Divider/ClkDiv.v
read_file -type verilog ../rtl/UART/UART_TX/MUX4x1.v
read_file -type verilog ../rtl/UART/UART_TX/parity_calc.v
read_file -type verilog ../rtl/UART/UART_TX/serializer.v
read_file -type verilog ../rtl/UART/UART_TX/TX_FSM.v
read_file -type verilog ../rtl/UART/UART_TX/UART_TX_TOP.v
read_file -type verilog ../rtl/UART/UART_TOP/UART.v
read_file -type verilog ../rtl/UART/UART_RX/data_sampler.v
read_file -type verilog ../rtl/UART/UART_RX/deserializer.v
read_file -type verilog ../rtl/UART/UART_RX/edge_bit_counter.v
read_file -type verilog ../rtl/UART/UART_RX/parity_check.v
read_file -type verilog ../rtl/UART/UART_RX/RX_FSM.v
read_file -type verilog ../rtl/UART/UART_RX/start_check.v
read_file -type verilog ../rtl/UART/UART_RX/stop_check.v
read_file -type verilog ../rtl/UART/UART_RX/UART_RX_TOP.v
read_file -type verilog ../rtl/Clock_Gating/CLK_GATE.v
read_file -type verilog ../rtl/DATA_SYNC/DATA_SYNC.v
read_file -type verilog ../rtl/PULSE_GEN/PULSE_GEN.v
read_file -type verilog ../rtl/RegFile/Reg_File.v
